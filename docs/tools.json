{
  "tools": [
    {
      "name": "list_jobs",
      "description": "Когда нужно получить список вакансий — все, активные, архивные или по фильтру. Используй для обзора вакансий компании.",
      "http": {
        "method": "GET",
        "path": "/api/v3/jobs"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "by_scope": {
            "type": "string",
            "enum": [
              "active",
              "archived",
              "all"
            ],
            "description": "Фильтр по статусу вакансий"
          },
          "page": {
            "type": "integer",
            "description": "Номер страницы"
          },
          "per_page": {
            "type": "integer",
            "description": "Количество записей на странице"
          }
        },
        "required": []
      }
    },
    {
      "name": "get_job",
      "description": "Когда нужно получить детальную информацию по конкретной вакансии — описание, статус, рекрутер, этапы.",
      "http": {
        "method": "GET",
        "path": "/api/v3/jobs/:id"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "integer",
            "description": "ID вакансии"
          }
        },
        "required": [
          "job_id"
        ]
      }
    },
    {
      "name": "create_job",
      "description": "Когда нужно создать новую вакансию в Потоке. Используй при запросе на открытие позиции.",
      "http": {
        "method": "POST",
        "path": "/api/v3/jobs"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Название вакансии"
          },
          "city": {
            "type": "string",
            "description": "Город"
          },
          "salary_from": {
            "type": "integer",
            "description": "Зарплата от"
          },
          "salary_to": {
            "type": "integer",
            "description": "Зарплата до"
          },
          "schedule_type": {
            "type": "string",
            "description": "Тип графика работы"
          },
          "experience_type": {
            "type": "string",
            "description": "Требуемый опыт работы"
          },
          "description": {
            "type": "string",
            "description": "Описание вакансии"
          },
          "company_department_id": {
            "type": "integer",
            "description": "ID отдела компании"
          },
          "demand": {
            "type": "integer",
            "description": "Количество требуемых сотрудников"
          },
          "closure_date": {
            "type": "string",
            "format": "date",
            "description": "Планируемая дата закрытия (YYYY-MM-DD)"
          },
          "private": {
            "type": "boolean",
            "description": "Скрытая вакансия (не публикуется на карьерном сайте)"
          },
          "job_type": {
            "type": "string",
            "description": "Тип вакансии"
          },
          "priority": {
            "type": "string",
            "description": "Приоритет вакансии"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "update_job",
      "description": "Когда нужно изменить параметры существующей вакансии — название, зарплату, описание и т.д.",
      "http": {
        "method": "PUT",
        "path": "/api/v3/jobs/:id"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "integer",
            "description": "ID вакансии"
          },
          "name": {
            "type": "string",
            "description": "Название вакансии"
          },
          "city": {
            "type": "string",
            "description": "Город"
          },
          "salary_from": {
            "type": "integer",
            "description": "Зарплата от"
          },
          "salary_to": {
            "type": "integer",
            "description": "Зарплата до"
          },
          "schedule_type": {
            "type": "string",
            "description": "Тип графика работы"
          },
          "experience_type": {
            "type": "string",
            "description": "Требуемый опыт работы"
          },
          "description": {
            "type": "string",
            "description": "Описание вакансии"
          },
          "company_department_id": {
            "type": "integer",
            "description": "ID отдела компании"
          },
          "demand": {
            "type": "integer",
            "description": "Количество требуемых сотрудников"
          },
          "closure_date": {
            "type": "string",
            "format": "date",
            "description": "Планируемая дата закрытия (YYYY-MM-DD)"
          },
          "private": {
            "type": "boolean",
            "description": "Скрытая вакансия"
          },
          "job_type": {
            "type": "string",
            "description": "Тип вакансии"
          },
          "priority": {
            "type": "string",
            "description": "Приоритет вакансии"
          }
        },
        "required": [
          "job_id"
        ]
      }
    },
    {
      "name": "change_job_state",
      "description": "Когда нужно изменить статус вакансии — поставить на паузу, закрыть, отменить или переоткрыть.",
      "http": {
        "method": "POST",
        "path": "/api/v3/jobs/:job_id/change_state"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "integer",
            "description": "ID вакансии"
          },
          "transition": {
            "type": "string",
            "enum": [
              "pause",
              "close",
              "cancel",
              "reopen"
            ],
            "description": "Действие: pause — пауза, close — закрыть, cancel — отменить, reopen — переоткрыть"
          }
        },
        "required": [
          "job_id",
          "transition"
        ]
      }
    },
    {
      "name": "assign_recruiter",
      "description": "Когда нужно назначить ответственного рекрутера на вакансию по email.",
      "http": {
        "method": "POST",
        "path": "/api/v3/jobs/:job_id/assign_executive_recruiter"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "integer",
            "description": "ID вакансии"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email рекрутера"
          }
        },
        "required": [
          "job_id",
          "email"
        ]
      }
    },
    {
      "name": "get_job_ajs_joins",
      "description": "Когда нужно получить список кандидатов, привязанных к конкретной вакансии (с их этапами и статусами).",
      "http": {
        "method": "GET",
        "path": "/api/v3/jobs/:job_id/ajs_joins"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "integer",
            "description": "ID вакансии"
          },
          "applicant_id": {
            "type": "integer",
            "description": "Фильтр по ID кандидата"
          },
          "page_size": {
            "type": "integer",
            "description": "Размер страницы"
          },
          "page_cursor": {
            "type": "string",
            "description": "Курсор для пагинации"
          }
        },
        "required": [
          "job_id"
        ]
      }
    },
    {
      "name": "get_job_state_histories",
      "description": "Когда нужно получить историю изменений статусов вакансий — кто и когда менял статус.",
      "http": {
        "method": "GET",
        "path": "/api/v3/jobs/state_histories"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "page_size": {
            "type": "integer",
            "description": "Размер страницы"
          },
          "page_cursor": {
            "type": "string",
            "description": "Курсор для пагинации"
          },
          "created_at_from": {
            "type": "string",
            "format": "date-time",
            "description": "Дата начала периода (ISO 8601)"
          },
          "created_at_to": {
            "type": "string",
            "format": "date-time",
            "description": "Дата конца периода (ISO 8601)"
          }
        },
        "required": []
      }
    },
    {
      "name": "add_users_to_jobs",
      "description": "Когда нужно добавить пользователей (нанимающих менеджеров, наблюдателей) к вакансиям пакетно.",
      "http": {
        "method": "POST",
        "path": "/api/v3/jobs_users"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "jobs_users": {
            "type": "array",
            "description": "Массив связей пользователь-вакансия",
            "items": {
              "type": "object",
              "properties": {
                "job_id": {
                  "type": "integer",
                  "description": "ID вакансии"
                },
                "user_id": {
                  "type": "integer",
                  "description": "ID пользователя"
                },
                "role": {
                  "type": "string",
                  "description": "Роль пользователя на вакансии"
                }
              },
              "required": [
                "job_id",
                "user_id"
              ]
            }
          }
        },
        "required": [
          "jobs_users"
        ]
      }
    },
    {
      "name": "list_applicants",
      "description": "Когда нужно получить список кандидатов с фильтрацией и поиском. Точный поиск по телефону/email — через фильтр f (f[phones][], f[emails][]); полнотекстовый поиск по ФИО — через q в формате Rails nested params.",
      "http": {
        "method": "GET",
        "path": "/api/v3/applicants"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "Номер страницы"
          },
          "per_page": {
            "type": "integer",
            "description": "Количество записей на странице"
          },
          "q": {
            "type": "array",
            "description": "Полнотекстовый поиск. Rails nested params: q[][s]=<строка>&q[][types][]=fios|phones|emails&q[][op]=and|or. НЕ передавать JSON-строкой."
          },
          "f": {
            "type": "object",
            "description": "Точные фильтры. f[phones][] — телефон (цифры с кодом страны, без +, напр. 79161234567), f[emails][] — email (осн. и доп. адреса), до 50 значений за запрос. Также: jobs, stages, stage_types, tags, sources, cities, responsible_users, created_at, born, salary и др."
          }
        },
        "required": []
      }
    },
    {
      "name": "get_applicant",
      "description": "Когда нужно получить полную карточку кандидата — контакты, резюме, историю по вакансиям.",
