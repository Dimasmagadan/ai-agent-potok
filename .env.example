POTOK_API_TOKEN=
POTOK_BASE_URL=https://demo.app.potok.io/api/v3

# C07 reopen: v2 base для declination_reasons/events; если не задано, выводится
# из POTOK_BASE_URL заменой /api/v3 на /api/v2
POTOK_API_V2_BASE_URL=

# Поток B (job_seeker.py): открытый Career API, без токена
POTOK_OPEN_BASE_URL=https://demo.potok.io/open
POTOK_CONSTRUCTOR_ID=

# Поток A: каталог локального CV-кэша (содержит PII, см. README)
CV_CACHE_DIR=.cv_cache

# Временный костыль, пока живой cv_original отдаёт 403 SignatureDoesNotMatch
# (заявка в поддержку Потока от 2026-09-03, см. README): путь к JSON
# {"<applicant_id>": "текст резюме"} — подставляется только при реальной
# ошибке скачивания и только для перечисленных кандидатов. Не задавать, если
# проблема уже решена на стороне Потока.
CV_MOCK_FALLBACK_FILE=

# Telegram-бот (scripts/tg_bot.py), опционально
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# C09 внутренний бот (только для сотрудников, allowlist обязателен — см. README):
# external (по умолчанию) — поведение C08 не меняется; internal — авторизованный
# GET /api/v3/jobs (требует POTOK_API_TOKEN/POTOK_BASE_URL выше), включая
# неопубликованные вакансии, jobs-gaps и память последнего профиля.
JOB_SEEKER_MODE=external
# Telegram user IDs сотрудников через запятую; internal без этого списка не стартует.
JOB_SEEKER_ALLOWED_USER_IDS=
# JOB_SEEKER_INCLUDE_PRIVATE=1 — показывать вакансии private:true (см. README §8)
JOB_SEEKER_INCLUDE_PRIVATE=
